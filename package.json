{
  "name": "blaterojam-boardgame",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run cards -s && tsc && vite build",
    "preview": "vite preview",
    "test:rooms": "node tools/test-rooms.mjs",
    "cards": "node --experimental-strip-types --no-warnings tools/cards/build.mjs",
    "test": "vitest run",
    "zip": "npm run build && rm -f release/blatero-itch.zip && mkdir -p release && cd dist && zip -qr ../release/blatero-itch.zip . && cd .. && ls -l release/blatero-itch.zip"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "puppeteer-core": "^25.16.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "@trystero-p2p/mqtt": "0.26.0",
    "preact": "^11.2.0",
    "trystero": "0.26.0"
  }
}
